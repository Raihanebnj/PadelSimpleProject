<Window x:Class="PadelSimple.Desktop.Views.ReservatieDialoog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding VensterTitel}"
        WindowStartupLocation="CenterOwner"
        Height="560" Width="440"
        ResizeMode="NoResize"
        Background="#F1F8E9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titel -->
            <RowDefinition Height="*"/>
            <!-- Formulier -->
            <RowDefinition Height="Auto"/>
            <!-- Prijs + knoppen -->
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0"
                   Text="{Binding VensterTitel}"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#1B5E20"
                   Margin="0,0,0,14"/>

        <!-- Formulier -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>
                <Label Content="Datum"/>
                <DatePicker SelectedDate="{Binding Datum}"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Starttijd (bv. 10:00)"/>
                        <TextBox Text="{Binding StartTijdString, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Eindtijd (bv. 11:00)"/>
                        <TextBox Text="{Binding EindTijdString, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Terrein"/>
                        <ComboBox ItemsSource="{Binding Terreinen}"
                                  SelectedItem="{Binding GeselecteerdTerrein}"
                                  DisplayMemberPath="Naam"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Spelers"/>
                        <TextBox Text="{Binding AantalSpelers, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Meerdere materialen selecteren -->
                <Label Content="Materiaal huren (optioneel, meerdere mogelijk)"
                       Margin="0,10,0,2" FontWeight="Bold" Foreground="#1B5E20"/>
                <Border Background="White" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="6" Padding="10">
                    <ItemsControl ItemsSource="{Binding MateriaalItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="55"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Naam}" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Huurprijs, StringFormat='€ {0:F2} / stuk'}" Foreground="#78909C" FontSize="11"/>
                                            <TextBlock Text="  • Stock: " Foreground="#78909C" FontSize="11"/>
                                            <TextBlock Text="{Binding AantalInInventaris}" Foreground="#2E7D32" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="Aantal:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Aantal, UpdateSourceTrigger=PropertyChanged}"
                                             Width="50"
                                             Padding="4,2"
                                             HorizontalContentAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Foutmelding -->
                <TextBlock Text="{Binding FoutBoodschap}"
                           Foreground="#C62828" Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Prijs en knoppen -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Border Background="#E8F5E9" CornerRadius="6" Padding="10,6"
                    DockPanel.Dock="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Totaal: " FontWeight="SemiBold" Foreground="#1B5E20"/>
                    <TextBlock Text="{Binding GeschatPrijs, StringFormat='€ {0:F2}'}"
                               FontWeight="Bold" Foreground="#1B5E20" FontSize="15"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Annuleren"
                        Width="90"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"
                        Command="{Binding AnnulerenCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                <Button Content="Opslaan"
                        Width="100"
                        IsDefault="True"
                        Command="{Binding OpslaanCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
