<Window x:Class="PadelSimple.Desktop.Views.TerreinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:PadelSimple.Desktop.Controls"
        Title="Terrein toevoegen / bewerken"
        Height="360" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F8E9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding TitelTekst}" FontSize="18" FontWeight="Bold"
                       Foreground="#1B5E20"/>
            <Separator Margin="0,8"/>
        </StackPanel>

        <!-- Formulier -->
        <StackPanel Grid.Row="1">
            <Label Content="Naam van het terrein"/>
            <TextBox Text="{Binding Naam, UpdateSourceTrigger=PropertyChanged}"
                     x:Name="NaamBox"/>

            <Label Content="Capaciteit (aantal spelers)"/>
            <TextBox Text="{Binding Capaciteit, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Uurtarief (€)"/>
            <TextBox Text="{Binding Uurtarief, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"/>

            <CheckBox Content="Overdekt terrein (indoors)"
                      IsChecked="{Binding IsIndoors}"
                      Margin="0,10,0,4"
                      FontWeight="SemiBold"
                      Foreground="#1B5E20"/>

            <!-- Status badge preview -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Status: " VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ctrl:StatusBadge Text="Overdekt" IsActief="{Binding IsIndoors}"/>
            </StackPanel>

            <TextBlock Text="{Binding FoutBoodschap}" Foreground="#C62828"
                       Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Knoppen -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuleren" Width="90"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <Button Content="Opslaan" Width="100"
                    IsDefault="True"
                    Click="Opslaan_Click"/>
        </StackPanel>
    </Grid>
</Window>
