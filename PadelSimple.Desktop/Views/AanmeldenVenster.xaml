<Window x:Class="PadelSimple.Desktop.Views.AanmeldenVenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadelSimple – Aanmelden"
        Height="620" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#F1F8E9"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" Width="400">

                <!-- Header titel -->
                <TextBlock Text="PadelSimple"
                           FontSize="26" FontWeight="Bold"
                           Foreground="#1B5E20"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <!-- ====== AANMELDEN ====== -->
                <Border Background="White" CornerRadius="10"
                        Padding="24" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                          Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Aanmelden" FontSize="18" FontWeight="Bold"
                                   Foreground="#1B5E20" Margin="0,0,0,14"/>

                        <TextBlock Text="E-mail of gebruikersnaam"/>
                        <TextBox x:Name="AanmeldEmailVak"
                                 Text="{Binding Gebruikersnaam, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Wachtwoord" Margin="0,4,0,0"/>
                        <PasswordBox x:Name="WachtwoordVak"
                                     PasswordChanged="WachtwoordVak_OnPasswordChanged"/>

                        <TextBlock Text="{Binding FoutBoodschap}"
                                   Foreground="#C62828"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding FoutBoodschap, Converter={StaticResource NullNaarZichtbaarheid}}"/>

                        <Button Content="Aanmelden"
                                HorizontalAlignment="Stretch"
                                Command="{Binding MeldAanCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                    </StackPanel>
                </Border>

                <!-- ====== REGISTRATIE ====== -->
                <Border Background="White" CornerRadius="10" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                          Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Nieuw account aanmaken" FontSize="18" FontWeight="Bold"
                                   Foreground="#1B5E20" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Voornaam"/>
                                <TextBox Text="{Binding RegistratieVoornaam, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Achternaam"/>
                                <TextBox Text="{Binding RegistratieAchternaam, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="E-mailadres"/>
                        <TextBox Text="{Binding RegistratieEmail, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Telefoonnummer (optioneel)"/>
                        <TextBox Text="{Binding RegistratieTelefoon, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Wachtwoord" Margin="0,4,0,0"/>
                        <PasswordBox x:Name="RegWachtwoord1" PasswordChanged="RegWachtwoord1_OnPasswordChanged"/>

                        <TextBlock Text="Herhaal wachtwoord"/>
                        <PasswordBox x:Name="RegWachtwoord2" PasswordChanged="RegWachtwoord2_OnPasswordChanged"/>

                        <CheckBox Content="Ik wil een lidmaatschap afsluiten"
                                  IsChecked="{Binding RegistratieIsLid}"
                                  Margin="0,8,0,4"
                                  Foreground="#1B5E20"
                                  FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding RegistratieFout}"
                                   Foreground="#C62828"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"/>

                        <Button Content="Account aanmaken"
                                HorizontalAlignment="Stretch"
                                Command="{Binding RegistreerCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
