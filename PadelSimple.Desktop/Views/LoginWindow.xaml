<Window x:Class="PadelSimple.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadelSimple – Aanmelden"
        Height="600" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#F1F8E9"
        ResizeMode="NoResize">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Linker kolom: banner -->
            <ColumnDefinition Width="2*"/>
            <!-- Rechter kolom: forms -->
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ====== BANNER (links) ====== -->
        <DockPanel Grid.Column="0" Background="#1B5E20" LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,30">
                <TextBlock Text="© 2026 PadelSimple"
                           Foreground="#A5D6A7" FontSize="11"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <TextBlock Text="🏓" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="PadelSimple"
                           FontSize="28" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Beheer uw reservaties snel &amp; eenvoudig"
                           FontSize="12" Foreground="#A5D6A7"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,8,0,0"/>

                <StackPanel Margin="0,30,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="✔" Foreground="#69F0AE" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Terreinen reserveren" Foreground="#E8F5E9"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="✔" Foreground="#69F0AE" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Materiaal huren" Foreground="#E8F5E9"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="✔" Foreground="#69F0AE" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Beheer als admin" Foreground="#E8F5E9"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- ====== FORMS (rechts) ====== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0">
            <StackPanel Margin="30,20">

                <!-- ====== LOGIN ====== -->
                <Border Background="White" CornerRadius="10"
                        Padding="24" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                          Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Aanmelden" FontSize="18" FontWeight="Bold"
                                   Foreground="#1B5E20" Margin="0,0,0,16"/>

                        <TextBlock Text="E-mail of gebruikersnaam"/>
                        <TextBox x:Name="LoginEmailBox"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Wachtwoord" Margin="0,4,0,0"/>
                        <PasswordBox x:Name="PwdBox"
                                     PasswordChanged="PwdBox_OnPasswordChanged"/>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#C62828"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>

                        <Button Content="Aanmelden"
                                HorizontalAlignment="Stretch"
                                Command="{Binding LoginCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </Border>

                <!-- ====== REGISTRATIE ====== -->
                <Border Background="White" CornerRadius="10" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                          Color="#CCCCCC" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Nieuw account aanmaken" FontSize="18" FontWeight="Bold"
                                   Foreground="#1B5E20" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Voornaam"/>
                                <TextBox Text="{Binding RegisterVoornaam, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Achternaam"/>
                                <TextBox Text="{Binding RegisterAchternaam, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="E-mailadres"/>
                        <TextBox Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Telefoonnummer (optioneel)"/>
                        <TextBox Text="{Binding RegisterTelefoon, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Wachtwoord" Margin="0,4,0,0"/>
                        <PasswordBox x:Name="RegPwd1" PasswordChanged="RegPwd1_OnPasswordChanged"/>

                        <TextBlock Text="Herhaal wachtwoord"/>
                        <PasswordBox x:Name="RegPwd2" PasswordChanged="RegPwd2_OnPasswordChanged"/>

                        <CheckBox Content="Ik wil een lidmaatschap afsluiten (korting op terreinen)"
                                  IsChecked="{Binding RegisterIsLid}"
                                  Margin="0,8,0,4"
                                  Foreground="#1B5E20"
                                  FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding RegisterError}"
                                   Foreground="#C62828"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"/>

                        <Button Content="Account aanmaken"
                                HorizontalAlignment="Stretch"
                                Command="{Binding RegisterCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
