<Window x:Class="PadelSimple.Desktop.Views.ReservationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="CenterOwner"
        Height="500" Width="420"
        ResizeMode="NoResize"
        Background="#F1F8E9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titel -->
            <RowDefinition Height="*"/>
            <!-- Formulier -->
            <RowDefinition Height="Auto"/>
            <!-- Prijs + knoppen -->
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0"
                   Text="{Binding WindowTitle}"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#1B5E20"
                   Margin="0,0,0,16"/>

        <!-- Formulier -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Label Content="Datum"/>
                <DatePicker SelectedDate="{Binding Date}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Starttijd (bv. 10:00)"/>
                        <TextBox Text="{Binding StartTimeString, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Eindtijd (bv. 11:00)"/>
                        <TextBox Text="{Binding EndTimeString, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Label Content="Terrein"/>
                <ComboBox ItemsSource="{Binding Courts}"
                          SelectedItem="{Binding SelectedCourt}"
                          DisplayMemberPath="Naam"/>

                <Label Content="Materiaal (optioneel)"/>
                <ComboBox ItemsSource="{Binding EquipmentList}"
                          SelectedItem="{Binding SelectedEquipment}"
                          DisplayMemberPath="Naam"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Aantal materiaal"/>
                        <TextBox Text="{Binding EquipmentQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Aantal spelers"/>
                        <TextBox Text="{Binding NumberOfPlayers, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C62828" Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Prijs en knoppen -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Border Background="#E8F5E9" CornerRadius="6" Padding="10,6"
                    DockPanel.Dock="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Geschatte prijs: " FontWeight="SemiBold" Foreground="#1B5E20"/>
                    <TextBlock Text="{Binding GeschatPrijs, StringFormat='€ {0:F2}'}"
                               FontWeight="Bold" Foreground="#1B5E20" FontSize="15"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Annuleren"
                        Width="90"
                        Style="{StaticResource SecondaryButton}"
                        IsCancel="True"
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Content="💾 Opslaan"
                        Width="100"
                        IsDefault="True"
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
