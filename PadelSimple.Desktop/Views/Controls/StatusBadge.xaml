<UserControl x:Class="PadelSimple.Desktop.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root"
             Height="26">

    <Border Background="{Binding BadgeAchtergrond, ElementName=root}"
            CornerRadius="13"
            Padding="10,4"
            Margin="2">
        <TextBlock Text="{Binding Text, ElementName=root}"
                   Foreground="White"
                   FontWeight="SemiBold"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</UserControl>
