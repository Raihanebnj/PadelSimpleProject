<Window x:Class="PadelSimple.Desktop.Views.Hoofdvenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PadelSimple.Desktop.Converters"
        xmlns:ctrl="clr-namespace:PadelSimple.Desktop.Controls"
        Title="PadelSimple – Beheer"
        Height="680" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F1F8E9">

    <Window.Resources>
        <conv:BoolNaarZichtbaarheidConverter x:Key="BoolNaarZichtbaarheid"/>
        <conv:BoolNaarStatusConverter x:Key="BoolNaarStatus"/>
    </Window.Resources>

    <DockPanel>

        <!-- ====== TOPBALK ====== -->
        <Border DockPanel.Dock="Top" Background="#1B5E20" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="PadelSimple" FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WelkomTekst}"
                               Foreground="#A5D6A7" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Afmelden"
                            Command="{Binding MeldAfCommand}"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="#69F0AE"
                            BorderThickness="1"
                            Padding="10,4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ====== HOOFDINHOUD ====== -->
        <TabControl x:Name="HoofdTabControl">

            <!-- ========================= TAB: RESERVATIES ========================= -->
            <TabItem Header="Reservaties">
                <DockPanel Margin="12">

                    <!-- Werkbalk -->
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Datum:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding GeselecteerdeDatum}" Width="140" Margin="0,0,10,0"/>
                        <Button Content="Laad" Command="{Binding LaadReservatiesCommand}" Margin="0,0,6,0"/>
                        <Button Content="Nieuwe Reservatie" Command="{Binding NieuweReservatieCommand}" Margin="0,0,6,0"/>
                        <Button Content="Bewerken"
                                Command="{Binding BewerkReservatieCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,6,0"/>
                        <Button Content="Verwijderen"
                                Command="{Binding VerwijderReservatieCommand}"
                                Style="{StaticResource DangerButton}"/>
                    </WrapPanel>

                    <!-- DataGrid Reservaties -->
                    <DataGrid ItemsSource="{Binding Reservaties}"
                              SelectedItem="{Binding GeselecteerdeReservatie}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum"
                                               Binding="{Binding Datum, StringFormat='{}{0:dd/MM/yyyy}'}"
                                               Width="100"/>
                            <DataGridTextColumn Header="Start"
                                               Binding="{Binding StartUur, StringFormat='{}{0:hh\\:mm}'}"
                                               Width="70"/>
                            <DataGridTextColumn Header="Einde"
                                               Binding="{Binding EindUur, StringFormat='{}{0:hh\\:mm}'}"
                                               Width="70"/>
                            <DataGridTextColumn Header="Terrein"
                                               Binding="{Binding Terrein.Naam}"
                                               Width="160"/>
                            <DataGridTextColumn Header="Spelers"
                                               Binding="{Binding AantalSpelers}"
                                               Width="55"/>
                            <DataGridTextColumn Header="Gehuurd Materiaal"
                                               Binding="{Binding MateriaalSamenvatting}"
                                               Width="200"/>
                            <DataGridTextColumn Header="Totaal"
                                               Binding="{Binding TotalePrijs, StringFormat='€ {0:F2}'}"
                                               Width="85"/>
                            <DataGridTextColumn Header="Gebruiker"
                                               Binding="{Binding Gebruiker.Email}"
                                               Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ========================= TAB: MIJN RESERVATIES ========================= -->
            <TabItem Header="Mijn Account">
                <DockPanel Margin="12">
                    <Border DockPanel.Dock="Top" Background="White" CornerRadius="8"
                            Padding="16" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding WelkomTekst}" FontSize="16" FontWeight="Bold"
                                       Foreground="#1B5E20"/>
                            <TextBlock Text="Hieronder ziet u enkel uw eigen reservaties."
                                       Foreground="#78909C"/>
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding MijnReservaties}"
                              SelectedItem="{Binding GeselecteerdeMijnReservatie}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum"
                                               Binding="{Binding Datum, StringFormat='{}{0:dd/MM/yyyy}'}"
                                               Width="100"/>
                            <DataGridTextColumn Header="Terrein"
                                               Binding="{Binding Terrein.Naam}"
                                               Width="180"/>
                            <DataGridTextColumn Header="Start"
                                               Binding="{Binding StartUur, StringFormat='{}{0:hh\\:mm}'}"
                                               Width="70"/>
                            <DataGridTextColumn Header="Einde"
                                               Binding="{Binding EindUur, StringFormat='{}{0:hh\\:mm}'}"
                                               Width="70"/>
                            <DataGridTextColumn Header="Gehuurd Materiaal"
                                               Binding="{Binding MateriaalSamenvatting}"
                                               Width="*"/>
                            <DataGridTextColumn Header="Prijs"
                                               Binding="{Binding TotalePrijs, StringFormat='€ {0:F2}'}"
                                               Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ========================= TAB: ADMIN BEHEER ========================= -->
            <TabItem Header="Beheer"
                     Visibility="{Binding IsAdmin, Converter={StaticResource BoolNaarZichtbaarheid}}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== Terreinen ===== -->
                    <GroupBox Header="Terreinen" Grid.Column="0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Nieuw" Command="{Binding NieuwTerreinCommand}" Margin="0,0,4,0"/>
                                <Button Content="Opslaan" Command="{Binding SlaTerreinenOpCommand}" Margin="0,0,4,0"/>
                                <Button Content="Verwijder" Command="{Binding VerwijderTerreinCommand}"
                                        Style="{StaticResource DangerButton}"/>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding Terreinen}"
                                      SelectedItem="{Binding GeselecteerdTerrein}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      RowEditEnding="DataGrid_RowEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="*"/>
                                    <DataGridTextColumn Header="Cap." Binding="{Binding Capaciteit}" Width="45"/>
                                    <DataGridCheckBoxColumn Header="Dak" Binding="{Binding IsIndoors}" Width="40"/>
                                    <DataGridTextColumn Header="€/u" Binding="{Binding Uurtarief, StringFormat='{}{0:F2}'}" Width="55"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <!-- ===== Materialen ===== -->
                    <GroupBox Header="Materialen" Grid.Column="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Nieuw" Command="{Binding NieuwMateriaalCommand}" Margin="0,0,4,0"/>
                                <Button Content="Opslaan" Command="{Binding SlaMaterialenOpCommand}" Margin="0,0,4,0"/>
                                <Button Content="Verwijder" Command="{Binding VerwijderMateriaalCommand}"
                                        Style="{StaticResource DangerButton}"/>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding MaterialenLijst}"
                                      SelectedItem="{Binding GeselecteerdMateriaal}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      RowEditEnding="DataGrid_RowEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="*"/>
                                    <DataGridTextColumn Header="Aantal" Binding="{Binding AantalInInventaris}" Width="55"/>
                                    <DataGridTextColumn Header="Prijs" Binding="{Binding Huurprijs, StringFormat='€{0:F2}'}" Width="55"/>
                                    <DataGridCheckBoxColumn Header="Actief" Binding="{Binding IsActief}" Width="50"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <!-- ===== Gebruikers ===== -->
                    <GroupBox Header="Gebruikers" Grid.Column="2">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button Content="Maak Admin" Command="{Binding MaakAdminCommand}" HorizontalAlignment="Stretch" Margin="0,2"/>
                                <Button Content="Verwijder Admin" Command="{Binding VerwijderAdminCommand}" HorizontalAlignment="Stretch" Margin="0,2" Style="{StaticResource SecondaryButton}"/>
                                <Button Content="Blokkeer" Command="{Binding BlokkeerGebruikerCommand}" HorizontalAlignment="Stretch" Margin="0,2" Style="{StaticResource DangerButton}"/>
                                <Button Content="Deblokkeer" Command="{Binding DeblokkeerGebruikerCommand}" HorizontalAlignment="Stretch" Margin="0,2" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding Gebruikers}"
                                      SelectedItem="{Binding GeselecteerdeGebruiker}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="Lid" Binding="{Binding IsLid}" Width="40"/>
                                    <DataGridCheckBoxColumn Header="Blok." Binding="{Binding IsGeblokkeerd}" Width="42"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
