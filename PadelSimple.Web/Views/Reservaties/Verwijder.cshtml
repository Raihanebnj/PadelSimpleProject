@model PadelSimple.Models.Domain.Reservatie
@using Microsoft.Extensions.Localization
@using PadelSimple.Web.Resources
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["Res_VerwijderenTitel"];
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow border-danger border-2">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0 fw-bold">@Localizer["Res_VerwijderenTitel"]</h4>
            </div>
            <div class="card-body p-4">
                <p class="lead">@Localizer["Res_VerwijderenBevestiging"]</p>
                <dl class="row">
                    <dt class="col-sm-4">@Localizer["Res_Datum"]:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Datum.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4">@Localizer["Res_Starttijd"]:</dt>
                    <dd class="col-sm-8">@Model.StartUur.ToString(@"hh\:mm") - @Model.EindUur.ToString(@"hh\:mm")</dd>

                    <dt class="col-sm-4">@Localizer["Res_Terrein"]:</dt>
                    <dd class="col-sm-8 text-success fw-bold">@Model.Terrein?.Naam</dd>

                    <dt class="col-sm-4">@Localizer["Res_Materiaal"]:</dt>
                    <dd class="col-sm-8">@Model.MateriaalSamenvatting</dd>

                    <dt class="col-sm-4">@Localizer["Res_TotalePrijs"]:</dt>
                    <dd class="col-sm-8 fw-bold text-success">€ @Model.TotalePrijs.ToString("F2")</dd>
                </dl>

                <form asp-action="Verwijder" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Overzicht" class="btn btn-secondary">@Localizer["Btn_Annuleren"]</a>
                        <button type="submit" class="btn btn-danger">@Localizer["Btn_Bevestigen"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
