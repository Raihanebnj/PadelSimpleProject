@using Microsoft.Extensions.Localization
@using PadelSimple.Web.Resources
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["Home_Titel"];
}

<div class="py-5 text-center">
    <h1 class="display-4 fw-bold text-success mb-3">@Localizer["Home_Titel"]</h1>
    <p class="lead text-muted col-md-8 mx-auto mb-4">
        @Localizer["Home_Subtitel"]
    </p>

    <div class="d-flex justify-content-center gap-3">
        <a asp-controller="Reservations" asp-action="Create" class="btn btn-success btn-lg shadow-sm">
            @Localizer["Home_TerreinReserveren"]
        </a>
        <a asp-controller="Courts" asp-action="Index" class="btn btn-outline-success btn-lg">
            @Localizer["Home_TerreinenBekijken"]
        </a>
        <a asp-controller="Equipment" asp-action="Index" class="btn btn-outline-secondary btn-lg">
            @Localizer["Home_MateriaalBekijken"]
        </a>
    </div>
</div>
