@model ErrorViewModel
@{
    ViewData["Title"] = "Fout";
}

<h1 class="text-danger">Fout.</h1>
<h2 class="text-danger">Er is een fout opgetreden tijdens het verwerken van uw aanvraag.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Ontwikkelingsmodus</h3>
<p>
    Wisselen naar de <strong>Development</strong>-omgeving toont meer gedetailleerde informatie over de opgetreden fout.
</p>
<p>
    <strong>De Development-omgeving mag niet ingeschakeld worden voor geïmplementeerde applicaties.</strong>
    Het kan resulteren in het tonen van gevoelige informatie uit uitzonderingen aan eindgebruikers.
    Schakel voor lokale debugging de <strong>Development</strong>-omgeving in door de omgevingsvariabele <strong>ASPNETCORE_ENVIRONMENT</strong> op <strong>Development</strong> te zetten
    en de app opnieuw te starten.
</p>
