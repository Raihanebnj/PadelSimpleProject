@model PadelSimple.Web.ViewModels.Materiaal.MateriaalEditVm
@using Microsoft.Extensions.Localization
@using PadelSimple.Web.Resources
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["Eq_BewerkenTitel"];
}

<div class="row justify-content-center mt-3">
    <div class="col-md-6">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0 fw-bold">@Localizer["Eq_BewerkenTitel"]</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Bewerk" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Localizer["Eq_Naam"]</label>
                        <input asp-for="Naam" class="form-control" />
                        <span asp-validation-for="Naam" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">@Localizer["Eq_AantalInVoorraad"]</label>
                            <input asp-for="Aantal" type="number" min="0" class="form-control" />
                            <span asp-validation-for="Aantal" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">@Localizer["Eq_PrijsPerStuk"]</label>
                            <input asp-for="Huurprijs" asp-format="{0:F2}" type="number" step="0.01" min="0.00" max="999.99" class="form-control" onblur="if(this.value) this.value = parseFloat(this.value).toFixed(2);" />
                            <span asp-validation-for="Huurprijs" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 form-check bg-light p-3 border rounded">
                        <input asp-for="IsActief" class="form-check-input ms-1 me-2" />
                        <label class="form-check-label fw-bold text-success" asp-for="IsActief">@Localizer["Geb_Actief"]</label>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Overzicht" class="btn btn-secondary">@Localizer["Btn_Annuleren"]</a>
                        <button type="submit" class="btn btn-success">@Localizer["Btn_Opslaan"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
