@model PadelSimple.Web.ViewModels.Gebruikers.GebruikerDetailsVm
@using Microsoft.Extensions.Localization
@using PadelSimple.Web.Resources
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["Geb_DetailsTitel"];
    var isAdmin = User.IsInRole("Admin");
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">← @Localizer["Btn_Terug"]</a>
</div>

<div class="row">
    <!-- Links: Gebruikersprofiel -->
    <div class="col-md-5 mb-4">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0 fw-bold">@Model.VolledigeNaam</h4>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-5">@Localizer["Geb_Email"]:</dt>
                    <dd class="col-sm-7 fw-bold">@Model.Email</dd>

                    <dt class="col-sm-5">@Localizer["Geb_Telefoon"]:</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Telefoon) ? "–" : Model.Telefoon)</dd>

                    <dt class="col-sm-5">@Localizer["Geb_IsLid"]:</dt>
                    <dd class="col-sm-7">
                        @if (Model.IsLid)
                        {
                            <span class="badge bg-success">✓ @Localizer["Geb_IsLid"]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">–</span>
                        }
                    </dd>

                    <dt class="col-sm-5">@Localizer["Geb_Status"]:</dt>
                    <dd class="col-sm-7">
                        @if (Model.IsGeblokkeerd)
                        {
                            <span class="badge bg-danger">@Localizer["Geb_IsGeblokkeerd"]</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@Localizer["Geb_Actief"]</span>
                        }
                    </dd>
                </dl>

                <hr />

                <h5 class="fw-bold text-success mb-3">@Localizer["Geb_Rollen"]</h5>
                <div class="mb-3">
                    @foreach (var rol in Model.Rollen)
                    {
                        <span class="badge @(rol == "Admin" ? "bg-danger" : rol == "Medewerker" ? "bg-primary" : "bg-success") p-2 fs-6 me-1 mb-1">
                            @rol
                            @if (isAdmin)
                            {
                                <form asp-action="VerwijderRol" asp-route-id="@Model.Id" asp-route-rol="@rol" method="post" class="d-inline ms-1">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-close btn-close-white btn-sm" aria-label="Verwijder"></button>
                                </form>
                            }
                        </span>
                    }
                </div>

                @if (isAdmin)
                {
                    <form asp-action="VoegRolToe" asp-route-id="@Model.Id" method="post" class="mt-3 p-3 bg-light rounded border">
                        @Html.AntiForgeryToken()
                        <label class="form-label fw-semibold">@Localizer["Geb_RolToewijzen"]:</label>
                        <div class="input-group">
                            <select name="rol" class="form-select">
                                @foreach (var r in Model.BeschikbareRollen.Where(x => !Model.Rollen.Contains(x)))
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-success">@Localizer["Btn_Toevoegen"]</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- Rechts: Reservatiehistoriek -->
    <div class="col-md-7">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0 fw-bold">@Localizer["Res_Titel"]</h4>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Localizer["Res_Datum"]</th>
                                <th>@Localizer["Res_Starttijd"]</th>
                                <th>@Localizer["Res_Terrein"]</th>
                                <th>@Localizer["Res_TotalePrijs"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Reservaties.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        <em>@Localizer["Res_GeenReservaties"]</em>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var r in Model.Reservaties)
                                {
                                    <tr>
                                        <td>@r.Datum.ToString("dd/MM/yyyy")</td>
                                        <td>@r.StartUur.ToString(@"hh\:mm") - @r.EindUur.ToString(@"hh\:mm")</td>
                                        <td>@r.TerreinNaam</td>
                                        <td class="fw-bold text-success">€ @r.TotalePrijs.ToString("F2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
