@model PadelSimple.Web.ViewModels.Auth.ProfielVm
@using Microsoft.Extensions.Localization
@using PadelSimple.Web.Resources
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["Nav_MijnProfiel"];
}

<div class="row justify-content-center mt-3">
    <div class="col-md-6">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0 fw-bold">👤 @Localizer["Nav_MijnProfiel"]</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Profiel" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" readonly disabled />
                        <div class="form-text">E-mailadres kan niet worden gewijzigd.</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Voornaam" class="form-label fw-semibold"></label>
                            <input asp-for="Voornaam" class="form-control" />
                            <span asp-validation-for="Voornaam" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Achternaam" class="form-label fw-semibold"></label>
                            <input asp-for="Achternaam" class="form-control" />
                            <span asp-validation-for="Achternaam" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefoon" class="form-label fw-semibold"></label>
                        <input asp-for="Telefoon" class="form-control" />
                        <span asp-validation-for="Telefoon" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Status Lidmaatschap</label>
                        <div>
                            @if (Model.IsLid)
                            {
                                <span class="badge bg-success p-2">✓ Betalend Lid</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary p-2">Geen actief lidmaatschap</span>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">@Localizer["Btn_Annuleren"]</a>
                        <button type="submit" class="btn btn-success">@Localizer["Btn_Opslaan"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
