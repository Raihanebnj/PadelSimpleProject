@model PadelSimple.Web.ViewModels.Auth.LoginVm
@using Microsoft.Extensions.Localization
@using PadelSimple.Web.Resources
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["Nav_Aanmelden"];
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-success text-white text-center py-3">
                <h4 class="mb-0 fw-bold">PadelSimple</h4>
                <small>@Localizer["Nav_Aanmelden"]</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="bijv. jan@padelsimple.be" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Wachtwoord" class="form-label fw-semibold"></label>
                        <input asp-for="Wachtwoord" type="password" class="form-control" />
                        <span asp-validation-for="Wachtwoord" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="OnthoudMij" class="form-check-input" />
                        <label asp-for="OnthoudMij" class="form-check-label"></label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg">@Localizer["Nav_Aanmelden"]</button>
                    </div>
                </form>
            </div>
            <div class="card-footer text-center py-3 bg-light">
                Nog geen account? <a asp-action="Register" class="text-success fw-bold">@Localizer["Nav_Registreren"]</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
