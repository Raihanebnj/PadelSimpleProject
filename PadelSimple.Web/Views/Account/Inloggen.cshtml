@model PadelSimple.Web.ViewModels.Auth.LoginVm
@using Microsoft.Extensions.Localization
@using PadelSimple.Web.Resources
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["Acc_LoginTitel"];
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-success text-white text-center py-3">
                <h4 class="mb-0 fw-bold">PadelSimple</h4>
                <small>@Localizer["Acc_LoginTitel"]</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Inloggen" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Localizer["Geb_Email"]</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Localizer["Acc_Wachtwoord"]</label>
                        <input asp-for="Wachtwoord" type="password" class="form-control" />
                        <span asp-validation-for="Wachtwoord" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-success btn-lg">@Localizer["Acc_LoginTitel"]</button>
                    </div>
                </form>
            </div>
            <div class="card-footer text-center py-3 bg-light">
                @Localizer["Acc_GeenAccount"] <a asp-action="Registreren" class="text-success fw-bold">@Localizer["Acc_RegisterTitel"]</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
