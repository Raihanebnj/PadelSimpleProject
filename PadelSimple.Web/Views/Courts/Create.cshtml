@model PadelSimple.Web.ViewModels.Courts.TerreinEditVm
@using Microsoft.Extensions.Localization
@using PadelSimple.Web.Resources
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["Court_ToevoegenTitel"];
}

<div class="row justify-content-center mt-3">
    <div class="col-md-6">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0 fw-bold">@Localizer["Court_ToevoegenTitel"]</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Localizer["Court_Naam"]</label>
                        <input asp-for="Naam" class="form-control" />
                        <span asp-validation-for="Naam" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">@Localizer["Court_Capaciteit"]</label>
                            <input asp-for="Capaciteit" type="number" min="1" max="10" class="form-control" />
                            <span asp-validation-for="Capaciteit" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">@Localizer["Court_Uurtarief"]</label>
                            <input asp-for="Uurtarief" type="number" step="0.50" class="form-control" />
                            <span asp-validation-for="Uurtarief" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 form-check bg-light p-3 border rounded">
                        <input asp-for="IsIndoors" class="form-check-input ms-1 me-2" />
                        <label asp-for="IsIndoors" class="form-check-label fw-bold text-success">@Localizer["Court_IsIndoor"]</label>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">@Localizer["Btn_Annuleren"]</a>
                        <button type="submit" class="btn btn-success">@Localizer["Btn_Opslaan"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
