@model PadelSimple.Web.ViewModels.Equipment.MateriaalEditVm
@using Microsoft.Extensions.Localization
@using PadelSimple.Web.Resources
@inject IStringLocalizer<SharedResources> Localizer

@{
    ViewData["Title"] = "Materiaal Bewerken";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-6">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0 fw-bold">✏️ Materiaal Bewerken</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Naam" class="form-label fw-semibold"></label>
                        <input asp-for="Naam" class="form-control" />
                        <span asp-validation-for="Naam" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Aantal" class="form-label fw-semibold"></label>
                            <input asp-for="Aantal" type="number" min="0" class="form-control" />
                            <span asp-validation-for="Aantal" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Huurprijs" class="form-label fw-semibold"></label>
                            <input asp-for="Huurprijs" type="number" step="0.25" class="form-control" />
                            <span asp-validation-for="Huurprijs" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 form-check bg-light p-3 border rounded">
                        <input asp-for="IsActief" class="form-check-input ms-1 me-2" />
                        <label asp-for="IsActief" class="form-check-label fw-bold text-success"></label>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">@Localizer["Btn_Annuleren"]</a>
                        <button type="submit" class="btn btn-success">💾 Wijzigingen Opslaan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
