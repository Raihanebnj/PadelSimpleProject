<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PadelSimple.Mobile.Views.LoginPagina"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Account">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Logged In Panel -->
            <VerticalStackLayout IsVisible="{Binding IsLoggedIn}" Spacing="14">
                <Frame Padding="16" CornerRadius="12" BorderColor="#512BD4" HasShadow="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Ingelogd als:" TextColor="Gray" FontSize="14"/>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="👤" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding UserEmail}" FontAttributes="Bold" FontSize="18" TextColor="#512BD4" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Button Text="Uitloggen" 
                        Command="{Binding LogoutCommand}" 
                        BackgroundColor="#D32F2F" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        HeightRequest="48" 
                        CornerRadius="8" />
            </VerticalStackLayout>

            <!-- Logged Out Panel -->
            <VerticalStackLayout IsVisible="{Binding IsNotLoggedIn}" Spacing="14">

                <Label Text="Inloggen" FontSize="24" FontAttributes="Bold" TextColor="#512BD4" />
                <Label Text="Meld je aan om reservaties te maken en te bekijken." TextColor="Gray"/>

                <Entry Placeholder="E-mailadres" Text="{Binding Email}" Keyboard="Email" HeightRequest="46"/>
                <Entry Placeholder="Wachtwoord" Text="{Binding Password}" IsPassword="True" HeightRequest="46"/>

                <Button Text="Inloggen" Command="{Binding LoginCommand}" BackgroundColor="#512BD4" TextColor="White" FontAttributes="Bold" HeightRequest="48" CornerRadius="8"/>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#512BD4"/>

            <!-- Info Message -->
            <Label Text="{Binding Info}" TextColor="Green" FontAttributes="Bold" HorizontalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding Info}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <Trigger TargetType="Label" Property="Text" Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </Trigger>
                </Label.Triggers>
            </Label>

            <!-- Error Message -->
            <Label Text="{Binding Error}" TextColor="Red" FontAttributes="Bold" HorizontalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding Error}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <Trigger TargetType="Label" Property="Text" Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </Trigger>
                </Label.Triggers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
