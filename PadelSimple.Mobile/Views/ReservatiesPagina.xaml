<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PadelSimple.Mobile.Views.ReservatiesPagina"
    Title="Overzicht Reservaties">

    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,0,12,0" VerticalOptions="Center">
            <Label Grid.Column="0" Text="Reservaties" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" VerticalOptions="Center"/>

            <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center" HorizontalOptions="End">
                <Label Text="{Binding UserEmail}" VerticalOptions="Center" FontAttributes="Bold" FontSize="13" TextColor="#512BD4" IsVisible="{Binding IsLoggedIn}"/>
                <Button Text="Uitloggen" Command="{Binding LogoutCommand}" BackgroundColor="#D32F2F" TextColor="White" Padding="10,0" HeightRequest="32" CornerRadius="6" FontSize="12" FontAttributes="Bold" IsVisible="{Binding IsLoggedIn}" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>
    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

            <!-- Header & Action -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Mijn Reservaties" FontSize="22" FontAttributes="Bold" />
                    <Label Text="Bekijk en filter bestaande reservaties" FontSize="13" TextColor="{AppThemeBinding Light=#404040, Dark=#ACACAC}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" 
                    Text="+ Nieuwe Reservatie" 
                    Command="{Binding GoToNewReservationCommand}" 
                    BackgroundColor="#512BD4" 
                    TextColor="White" 
                    CornerRadius="8"
                    FontAttributes="Bold" />
            </Grid>
            <!-- Main Content -->
            <VerticalStackLayout Grid.Row="1" Spacing="12">
                <!-- Filter Bar -->
                <Frame Padding="12" CornerRadius="10" BorderColor="{AppThemeBinding Light=#ACACAC, Dark=#404040}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" HasShadow="False">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="Datum:" VerticalOptions="Center" FontAttributes="Bold" />
                        <DatePicker Date="{Binding SelectedDate}" VerticalOptions="Center" />
                        <Button Text="Zoeken" Command="{Binding LoadCommand}" VerticalOptions="Center" HeightRequest="40"/>
                    </HorizontalStackLayout>
                </Frame>

                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="#512BD4" />

                <!-- Error Label -->
                <Label Text="{Binding Error}" TextColor="Red" FontAttributes="Bold">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Error}" Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <Trigger TargetType="Label" Property="Text" Value="{x:Null}">
                            <Setter Property="IsVisible" Value="False" />
                        </Trigger>
                    </Label.Triggers>
                </Label>

                <!-- Reservations List -->
                <CollectionView ItemsSource="{Binding Items}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="30" HorizontalOptions="Center" Spacing="10">
                            <Label Text="Geen reservaties gevonden voor deze datum." TextColor="{AppThemeBinding Light=#404040, Dark=#ACACAC}" HorizontalOptions="Center" FontSize="16"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="14" Margin="0,6" BorderColor="{AppThemeBinding Light=#ACACAC, Dark=#404040}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#212121}" CornerRadius="12" HasShadow="True">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding TerreinNaam}" FontAttributes="Bold" FontSize="18"/>
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Datum, StringFormat='{0:dd/MM/yyyy}'}" TextColor="{AppThemeBinding Light=#404040, Dark=#919191}" FontAttributes="Italic" HorizontalOptions="End"/>

                                    <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="16" Margin="0,4,0,0">
                                        <Label Text="{Binding StartUur, StringFormat='Start: {0}'}" FontAttributes="Bold" TextColor="#512BD4"/>
                                        <Label Text="{Binding EindUur, StringFormat='Einde: {0}'}" FontAttributes="Bold" TextColor="#512BD4"/>
                                    </HorizontalStackLayout>

                                    <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding AantalSpelers, StringFormat='Aantal spelers: {0}'}" Margin="0,4,0,0"/>
                                    <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding MateriaalNaam, StringFormat='Materiaal: {0}'}" TextColor="{AppThemeBinding Light=#404040, Dark=#ACACAC}" Margin="0,2,0,0"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
