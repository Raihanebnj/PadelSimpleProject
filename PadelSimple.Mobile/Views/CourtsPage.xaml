<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PadelSimple.Mobile.Views.CourtsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Terreinen">

    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,0,12,0" VerticalOptions="Center">
            <Label Grid.Column="0" Text="Terreinen" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>

            <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center" HorizontalOptions="End">
                <Label Text="{Binding UserEmail}" VerticalOptions="Center" FontAttributes="Bold" FontSize="13" TextColor="#512BD4" IsVisible="{Binding IsLoggedIn}"/>
                <Button Text="Uitloggen" Command="{Binding LogoutCommand}" BackgroundColor="#D32F2F" TextColor="White" Padding="10,0" HeightRequest="32" CornerRadius="6" FontSize="12" FontAttributes="Bold" IsVisible="{Binding IsLoggedIn}" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12">

            <HorizontalStackLayout>
                <Label Text="Terreinen Overzicht" FontSize="20" FontAttributes="Bold" />
                <Button Text="Refresh" Command="{Binding LoadCommand}" HorizontalOptions="EndAndExpand" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#512BD4" />

            <Label Text="{Binding Info}" TextColor="Green">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding Info}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <Trigger TargetType="Label" Property="Text" Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </Trigger>
                </Label.Triggers>
            </Label>

            <Label Text="{Binding Error}" TextColor="Red">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding Error}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                    <Trigger TargetType="Label" Property="Text" Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </Trigger>
                </Label.Triggers>
            </Label>

            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="12" Margin="0,6" BorderColor="#444" CornerRadius="10" HasShadow="True">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Capacity, StringFormat='Capaciteit: {0} personen'}" />
                                <Label Text="{Binding IsIndoor, StringFormat='Indoor: {0}'}" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
